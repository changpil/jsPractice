{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "TSX: Current File",
            "type": "node",
            "request": "launch",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "--import",
                "tsx"
            ],
            "program": "${file}"
        }
    ]
}
